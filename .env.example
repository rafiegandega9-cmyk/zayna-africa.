# Supabase → Project Settings → API. Publishable key may be exposed to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Keep the secret key server-only. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Sandbox credentials only for the demo. Keep both values server-only.
GENIUSPAY_API_KEY=
GENIUSPAY_API_SECRET=
# Create a GeniusPay sandbox webhook pointing to the public HTTPS /api/webhooks/geniuspay route.
GENIUSPAY_WEBHOOK_SECRET=

# Public origin, for example https://zayna.example
NEXT_PUBLIC_SITE_URL=http://localhost:3000
